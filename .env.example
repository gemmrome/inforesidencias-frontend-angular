# Copia este fichero a .env.local (en la raíz del proyecto, junto a package.json) y
# rellena los valores. .env.local NO se versiona (ver .gitignore). En servidor/producción
# es preferible definir estas variables directamente en el entorno (systemd, Docker, etc.)
# en vez de con un fichero.

# --- API de Inforesidencias (obligatoria para sync:full / sync:incremental) ---
# Credencial Basic Auth (usuario "Infoelder") contra api.inforesidencias.com. Sin esto,
# `npm run sync:full` no puede generar data/indice-centros.json y el buscador no tendrá
# centros que listar.
API_KEY_API_IR=
# API_IR_BASE_URL=https://api.inforesidencias.com/api
# API_IR_USER=Infoelder

# --- Revalidación de caché tras sincronizar (opcional en local) ---
# REVALIDAR_TOKEN=
# REVALIDAR_URL=http://127.0.0.1:3001,http://127.0.0.1:3002

# --- Servidor Express / SSR ---
# PORT=4000
# SITE_URL=https://www.inforesidencias.com
# ASSETS_HOST=https://www.inforesidencias.com
# APP_ENTORNO=desarrollo   # desarrollo | preproduccion | produccion
# PREPRODUCCION=0          # 1 para activar el modo preproducción (banner, noindex, etc.)

# --- Cliente (se envían al navegador vía TransferState, ver app.config.server.ts) ---
# RECAPTCHA_SITE_KEY=
# GTM_ID=
# CHAT_WIDGET_URL=

# --- Puente de leads (formularios de contacto/búsqueda proactiva) ---
# PUENTE_MODO=dry-run      # dry-run no envía nada de verdad; usar "real" en producción
# PUENTE_BASE_URL=https://www.inforesidencias.com

# --- Intérprete de búsqueda libre por IA (opcional; sin esto cae a interpretación local) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CF_AI_MODELO=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Integración de menús/comida (opcional) ---
# COMIDA_ACTIVO=0
# COMIDA_BASE_URL=
# COMIDA_ANON_KEY=
